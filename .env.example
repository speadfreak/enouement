# ============================================================================
# ENOUEMENT 2K27 — Environment Variables
# Copy this file to `.env` and fill in your real values. NEVER commit .env.
# ============================================================================

# ---- Database (Neon PostgreSQL) ----
# Get this from your Neon dashboard: https://neon.tech
# The pooler URL is recommended for serverless (Vercel).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
# Direct (non-pooled) connection — used by Prisma migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# ---- NextAuth ----
# Generate a secret: `openssl rand -base64 32` or https://generate-secret.now.sh/32
NEXTAUTH_SECRET="change-me-to-a-long-random-string"
# In production, set this to your deployed URL (e.g. https://enouement2k27.et)
# In dev, use http://localhost:3000
NEXTAUTH_URL="http://localhost:3000"

# ---- Site ----
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---- Super Admin (seed only — used by `bun run seed` to create the first admin) ----
SUPER_ADMIN_EMAIL="admin@enouement2k27.et"
SUPER_ADMIN_PASSWORD="ChangeMe!StrongPassword123"

# ---- Optional: Cloudinary (for image/video uploads) ----
# If set, /api/upload uses Cloudinary. If NOT set, uploads fall back to
# base64 data URLs stored directly in the DB (works with zero setup, but
# Cloudinary is recommended for production for better performance + CDN).
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""
